DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-a-new-password
DB_NAME=soventory
DB_SSL=true
# Optional CA certificate for providers using a private CA; escaped newlines are supported.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
CORS_ORIGINS=https://soventory.jevs.ch,http://localhost:3000
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_A_NEW_RSA_KEY_OF_AT_LEAST_2048_BITS\n-----END PRIVATE KEY-----
